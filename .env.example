# Angular no lee este archivo en runtime.
# Los valores reales están en src/environments/environment.ts
# y src/environments/environment.production.ts.
#
# siteUrl          Origen canónico. Hoy: http://localhost:4200
# contactEmail     Correo de contacto. Valor inicial: afriasdev@gmail.com
# contactFormUrl   URL de un proveedor de formularios. Vacío = no hay envío automático.
#
# Al publicar, cambia también las URLs absolutas de public/sitemap.xml y public/robots.txt.
